{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aktin.org/schema/meld/contract.schema.json",
  "title": "MELD Inference Runtime Contract",
  "description": "",
  "type": "object",
  "properties": {
    "schema_version": {
      "description": "Schema version of the inference runtime contract",
      "type": "string"
    },
    "contract": {
      "description": "Inference runtime metadata",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name of the inference runtime, use alphanumeric characters and hyphens only",
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "maxLength": 50,
          "minLength": 1,
          "examples": [
            "heatwave-patient-encounter"
          ]
        },
        "description": {
          "description": "Description of the inference runtime",
          "type": "string"
        },
        "version": {
          "description": "Name of the inference runtime, use alphanumeric characters and hyphens only",
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "maxLength": 50,
          "minLength": 1,
          "examples": [
            "1.0.0"
          ]
        }
      },
      "required": [
        "name",
        "description",
        "version"
      ]
    },
    "runtime": {
      "description": "Inference runtime configuration",
      "type": "object",
      "properties": {
        "framework": {
          "description": "Deep learning framework used in the inference runtime",
          "type": "string",
          "examples": [
            "Tensorflow",
            "sklearn",
            "PyTorch"
          ],
          "minLength": 1
        },
        "image": {
          "description": "Docker image identifier of the inference runtime, will used to pull the image from a registry. The constructed identifier will be: <name>:<tag>@<digest>",
          "type": "object",
          "properties": {
            "name": {
              "description": "Docker image repository",
              "type": "string",
              "examples": [
                "ghcr.io/aktin/heatwave-patient-encounter"
              ],
              "minLength": 1
            },
            "tag": {
              "description": "Docker image tag",
              "type": "string",
              "examples": [
                "0.1.0",
                "3.0",
                "1.0.0-rc.1+20210101.123456"
              ],
              "minLength": 1
            },
            "digest": {
              "description": "Docker image digest",
              "type": "string"
            }
          },
          "required": [
            "name",
            "tag",
            "digest"
          ]
        },
        "environment_variables": {
          "description": "Environment variables to be set in the inference runtime",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "framework",
        "image"
      ]
    },
    "schedule": {
      "type": "object",
      "properties": {
        "timezone": {
          "description": "Time zone of the server, defaults to Europe/Berlin",
          "type": "string",
          "default": "Europe/Berlin"
        },
        "expression": {
          "description": "Crontab expression, for more details see https://en.wikipedia.org/wiki/Cron ",
          "type": "string",
          "format": "regex",
          "pattern": "^((((\\d+,)+\\d+|(\\d+(\\/|-|#)\\d+)|\\d+L?|\\*(\\/\\d+)?|L(-\\d+)?|\\?|[A-Z]{3}(-[A-Z]{3})?) ?){5,7})$"
        }
      },
      "required": [
        "expression"
      ],
      "unevaluatedProperties": false
    },
    "input_schema": {
      "description": "Input schema of the inference runtime",
      "type": "object",
      "properties": {
        "temporal_scope": {
          "description": "Temporal scope of the input schema",
          "type": "object",
          "properties": {
            "type": {
              "description": "Type of scope, only relative scopes are supported at the moment",
              "$ref": "#/$defs/temporal_scope_type"
            },
            "value": {
              "type": "string"
            },
            "anchor": {
              "type": "string",
              "format": "date-time"
            },
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "relative"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "description": "Value of the relative scope, must be ISO-8601 duration format. Absolute value will be subtracted from anchor. E.g. P1Y2M3DT4H5M6S for 1 year, 2 months, 3 days, 4 hours, 5 minutes, 6 seconds.",
                    "type": "string",
                    "format": "duration",
                    "examples": [
                      "P1Y2M3DT4H5M6S"
                    ]
                  },
                  "anchor": {
                    "description": "Anchor of the relative scope, must be ISO-8601 date-time format",
                    "type": "string",
                    "format": "date-time",
                    "examples": [
                      "2000-01-01T00:00:00Z",
                      "1970-01-01T00:00:00Z",
                      "9999-12-31T23:59:59Z",
                      "1985-04-12T23:20:50.52Z",
                      "1996-12-19T16:39:57-08:00",
                      "1953-01-01T12:00:27.87+00:20"
                    ]
                  }
                },
                "required": [
                  "value",
                  "anchor"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "absolute"
                  }
                }
              },
              "then": {
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "start",
                  "end"
                ]
              }
            }
          ]
        },
        "features": {
          "description": "Input features of the inference runtime model",
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          },
          "minItems": 1
        },
        "query": {
          "description": "Query for the inference runtime model",
          "type": "object",
          "properties": {
            "type": {
              "$ref": "#/$defs/query_type"
            },
            "statement": {
              "description": "Statement to be executed against the Aktin DWH",
              "type": "string"
            }
          },
          "required": [
            "type",
            "statement"
          ]
        }
      },
      "required": [
        "temporal_scope",
        "features",
        "query"
      ]
    },
    "output_schema": {
      "description": "Output schema of the inference runtime",
      "type": "object",
      "properties": {
        "type": {
          "description": "File type of the result file, currently only CSV supported, might be subject to change",
          "$ref": "#/$defs/output_file_type"
        },
        "labels": {
          "description": "Label columns of the result file",
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "labels"
      ]
    }
  },
  "required": [
    "contract",
    "runtime",
    "input_schema",
    "output_schema"
  ],
  "$defs": {
    "temporal_scope_type": {
      "type": "string",
      "enum": [
        "relative",
        "absolute"
      ],
      "title": "TemporalScopeType"
    },
    "query_type": {
      "type": "string",
      "enum": [
        "sql"
      ],
      "title": "QueryType"
    },
    "output_file_type": {
      "type": "string",
      "enum": [
        "csv"
      ],
      "title": "OutputFileType"
    },
    "feature": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "datatype": {
          "description": "Datatypes of the feature, currently only Int64, Float64, boolean, string, datetime64[ns] supported, might be subject to change. If the datatype is mismatching the type of the respective query result column, the orchestrator will throw an error",
          "type": "string",
          "enum": [
            "Int64",
            "Float64",
            "boolean",
            "string",
            "datetime64[ns]"
          ]
        },
        "required": {
          "description": "Required flag, if required feature is missing, the orchestrator will throw an error",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "datatype"
      ]
    }
  }
}
